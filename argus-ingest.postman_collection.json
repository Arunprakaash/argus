{
  "info": {
    "name": "Argus Ingest API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ingest Vision Proctor Events",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ingest_api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"events\": [\n    {\n      \"roomName\": \"interview_example_room\",\n      \"source\": \"vision_proctor\",\n      \"type\": \"vision_mobile_device_detected\",\n      \"ts\": \"2026-07-03T14:30:00.000Z\",\n      \"data\": {\n        \"timestamp\": \"2026-07-03T14:30:00.000Z\",\n        \"source_identity\": \"candidate_example\",\n        \"frame_width\": 1280,\n        \"frame_height\": 720,\n        \"face_detected\": true,\n        \"face_count\": 1,\n        \"faces\": [],\n        \"devices\": [\n          {\n            \"class\": \"cell_phone\",\n            \"confidence\": 0.86,\n            \"box\": { \"x1\": 0.62, \"y1\": 0.31, \"x2\": 0.78, \"y2\": 0.74 }\n          }\n        ],\n        \"elapsed_interview_seconds\": 42.5\n      }\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ingest/events",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ingest",
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Dashboard: Annotations",
      "item": [
        {
          "name": "Add Session Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{session_cookie}}",
                "type": "text",
                "description": "Supabase auth session cookie from a signed-in browser session."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Example QA note — false positive on proctoring flag.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/annotations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "annotations"
              ]
            },
            "description": "Creates a note on a session. Author is derived server-side from the signed-in user's email local part. Requires a valid Supabase session cookie (401 without auth)."
          },
          "response": []
        },
        {
          "name": "Delete Session Note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{session_cookie}}",
                "type": "text",
                "description": "Supabase auth session cookie from a signed-in browser session."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotationId\": \"{{annotation_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/annotations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "annotations"
              ]
            },
            "description": "Deletes a note from a session. Requires a valid Supabase session cookie (401 without auth)."
          },
          "response": []
        },
        {
          "name": "Get Interview Recording URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{session_cookie}}",
                "type": "text",
                "description": "Supabase auth session cookie from a signed-in browser session."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/interview-recording",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "interview-recording"
              ]
            },
            "description": "Returns a short-lived presigned URL for the interview video stored in AWS S3. Reads metadata.recording_url (S3 HTTPS URL). Requires INTERVIEW_S3_BUCKET, INTERVIEW_S3_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY. 404 if no recording in metadata; 401 without auth."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard: Semantic Search",
      "item": [
        {
          "name": "Semantic Search Sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"candidate confused about system design\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sessions/semantic-search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "semantic-search"
              ]
            },
            "description": "Natural-language session search via transcript embeddings. Returns { sessions: [], disabled: true } when semantic_search.enabled is false in settings (no OpenAI call). When enabled, embeds the query and runs match_sessions."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "ingest_api_key",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "annotation_id",
      "value": ""
    },
    {
      "key": "session_cookie",
      "value": ""
    }
  ]
}
